# RideTogether Server Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit real credentials.

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/ridetogether

# Frontend origin (used for CORS and cookie SameSite)
CLIENT_URL=http://localhost:5173

# JWT secrets — generate strong random values (e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie settings
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (HTTPS)
