NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ridetogether
CLIENT_URL=http://localhost:5173
# Optional comma-separated browser origins when using a non-default host.
# CLIENT_URLS=http://localhost:5173,http://192.168.1.20:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
